{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Unit Loadout",
    "description": "",
    "type": "object",
    "properties": {
        "loadouts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "ability_picking_order": {
                        "type": "array",
                        "items": {
                            "type": "integer",
                            "minimum": 0
                        }
                    },
                    "name": {
                        "type": "string"
                    },
                    "required_items": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "candidates": {
                                    "type": "array",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "item": {
                                                "$ref": "#/$defs/unit_item_definition_ptr"
                                            },
                                            "priority": {
                                                "type": "integer",
                                                "minimum": 1,
                                                "maximum": 10
                                            }
                                        },
                                        "required": [
                                            "item",
                                            "priority"
                                        ],
                                        "unevaluatedProperties": false
                                    }
                                },
                                "slot_index": {
                                    "type": "integer",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "candidates",
                                "slot_index"
                            ],
                            "unevaluatedProperties": false
                        }
                    }
                },
                "required": [
                    "name"
                ],
                "unevaluatedProperties": false
            }
        },
        "required_loadouts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "loadout": {
                        "type": "string"
                    },
                    "priority": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 10
                    },
                    "target_count_in_empire": {
                        "type": "integer",
                        "minimum": 1
                    }
                },
                "required": [
                    "loadout",
                    "priority",
                    "target_count_in_empire"
                ],
                "unevaluatedProperties": false
            }
        },
        "version": {
            "type": "integer"
        },
        "weighted_random_loadouts": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "loadout": {
                        "type": "string"
                    },
                    "weight": {
                        "type": "number",
                        "exclusiveMinimum": 0.0
                    }
                },
                "required": [
                    "loadout",
                    "weight"
                ],
                "unevaluatedProperties": false
            }
        }
    },
    "required": [
        "loadouts",
        "weighted_random_loadouts"
    ],
    "unevaluatedProperties": false,
    "$defs": {
        "unit_item_definition_ptr": {
            "type": "string"
        }
    }
}