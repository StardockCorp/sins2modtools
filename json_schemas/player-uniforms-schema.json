                            "properties": {
                                "description": {
                                    "type": "string"
                                },
                                "hud_icon": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "tooltip_icon": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "description",
                                "hud_icon",
                                "name",
                                "tooltip_icon"
                            ],
                            "unevaluatedProperties": false
                        },
                        "share_vision": {
                            "type": "object",
                            "properties": {
                                "description": {
                                    "type": "string"
                                },
                                "hud_icon": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "tooltip_icon": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "description",
                                "hud_icon",
                                "name",
                                "tooltip_icon"
                            ],
                            "unevaluatedProperties": false
                        },
                        "synergy": {
                            "type": "object",
                            "properties": {
                                "description": {
                                    "type": "string"
                                },
                                "hud_icon": {
                                    "type": "string"
                                },
                                "name": {
                                    "type": "string"
                                },
                                "tooltip_icon": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "description",
                                "hud_icon",
                                "name",
                                "tooltip_icon"
                            ],
                            "unevaluatedProperties": false
                        }
                    },
                    "unevaluatedProperties": false
                },
                "max_alliance_lock_duration": {
                    "type": "integer"
                }
            },
            "required": [
                "alliance_offer_duration",
                "alliance_types",
                "max_alliance_lock_duration"
            ],
            "unevaluatedProperties": false
        },
        "auto_upgrade_planet_track_price_threshold_multiplier": {
            "type": "number"
        },
        "colonization_victory_planet_count_percentage": {
            "type": "number"
        },
        "default_corruption_thresholds": {
            "description": "default corruption threshold fractions used when unit and player data do not override them",
            "type": "array",
            "items": {
                "type": "number",
                "minimum": 0.0,
                "maximum": 1.0
            }
        },
        "default_negative_corruption_buffs": {
            "description": "default negative corruption buffs used when unit and player data do not override them",
            "type": "array",
            "items": {
                "$ref": "#/definitions/buff_definition_ptr"
            }
        },
        "dlc_only_pickable_players": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "dlc_pickable_players": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "players": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "product_id": {
                        "type": "string"
                    }
                },
                "unevaluatedProperties": false
            }
        },
        "dominant_culture_influence_points_gained_duration": {
            "type": "array",
            "items": {
                "type": "number"
            }
        },
        "exotics_refund_percentage": {
            "type": "number"
        },
        "fallback_theme_picker_skybox": {
            "type": "string"
        },
        "fleet_factory_rally_hyperspace_charge_time": {
            "type": "number"
        },
        "fleet_factory_rally_hyperspace_speed": {
            "type": "number"
        },
        "fleet_factory_rally_hyperspace_speed_between_stars": {
            "type": "number"
        },
        "fleet_factory_rally_subspace_speed": {
            "type": "number"
        },
        "marginal_tax_rate_levels": {
            "type": "object",
            "properties": {
                "credits": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "rate_taxable": {
                                "type": "number"
                            },
                            "tax_rate": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "tax_rate"
                        ],
                        "unevaluatedProperties": false
                    }
                },
                "crystal": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "rate_taxable": {
                                "type": "number"
                            },
                            "tax_rate": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "tax_rate"
                        ],
                        "unevaluatedProperties": false
                    }
                },
                "metal": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "rate_taxable": {
                                "type": "number"
                            },
                            "tax_rate": {
                                "type": "number"
                            }
                        },
                        "required": [
                            "tax_rate"
                        ],
                        "unevaluatedProperties": false
                    }
                }
            },
            "unevaluatedProperties": false
        },
        "max_fleet_count": {
            "type": "integer"
        },
        "max_fleet_supply_scalar": {
            "type": "number"
        },
        "max_research_points_overflow": {
            "type": "number"
        },
        "max_research_rate_scalar": {
            "type": "number"
        },
        "npc": {
            "type": "object",
            "properties": {
                "asset_market": {
                    "type": "object",
                    "properties": {
                        "demand_level_change_cooldown_duration": {
                            "type": "number"
                        },
                        "demand_level_change_thresholds": {
                            "type": "array",
                            "items": {
                                "type": "number"
                            }
                        },
                        "demand_levels": {
                            "type": "array",
                            "items": {
                                "type": "object",
                                "properties": {
                                    "buy_credits_cost_scalar": {
                                        "type": "number"
                                    },
                                    "color": {
                                        "type": "string"
                                    },
                                    "hud_icon": {
                                        "type": "string"
                                    },
                                    "is_visible_in_npc_markets_window": {
                                        "type": "boolean"
                                    },
                                    "name": {
                                        "type": "string"
                                    },
                                    "sell_credits_received_scalar": {
                                        "type": "number"
                                    }
                                },
                                "required": [
                                    "buy_credits_cost_scalar",
                                    "color",
                                    "hud_icon",
                                    "name",
                                    "sell_credits_received_scalar"
                                ],
                                "unevaluatedProperties": false
                            }
                        },
                        "fluctuation": {
                            "description": "continuous market price drift tuning",
                            "type": "object",
                            "properties": {
                                "max_scalar": {
                                    "description": "highest the price is allowed to drift to, as a scalar of the base price",
                                    "type": "number"
                                },
                                "max_snapshot_count": {
                                    "description": "maximum number of price history snapshots to retain",
                                    "type": "integer"
                                },
                                "mean_reversion_strength": {
                                    "description": "fraction of the distance back to the price the market is settling toward recovered per update",
                                    "type": "number"
                                },
                                "min_scalar": {
                                    "description": "lowest the price is allowed to drift to, as a scalar of the base price",
                                    "type": "number"
                                },
                                "regime_decay_strength": {
                                    "description": "how quickly the market settles back to its base price after a shock",
                                    "type": "number"
                                },
                                "shock_interval_seconds_range": {
                                    "description": "how long between market crashes and spikes",
                                    "$ref": "#/definitions/float_range"
                                },
                                "shock_magnitude_range": {
                                    "description": "how far a shock moves the price, as a fraction of the base price",
                                    "$ref": "#/definitions/float_range"
                                },
                                "shock_regime_retention": {
                                    "description": "fraction of a shock that persists as the new price the market reverts to",
                                    "type": "number"
                                },
                                "trade_impact_scalar_per_unit": {
                                    "description": "immediate price impact per unit bought or sold by a player",
                                    "type": "number"
                                },
                                "update_interval_seconds": {
                                    "description": "how often the market price takes a random step",
                                    "type": "number"
                                },
                                "volatility": {
                                    "description": "maximum size of a single random price step",
                                    "type": "number"
                                }
                            },
                            "unevaluatedProperties": false
                        },
                        "initial_demand_level": {
                            "type": "integer"
                        }
                    },
                    "required": [
                        "demand_level_change_cooldown_duration",
                        "demand_level_change_thresholds",
                        "initial_demand_level"
                    ],
                    "unevaluatedProperties": false
                },
                "auction_cooldown_durations": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/float_range"
                    }
                },
                "bounty_market_max_snapshot_count": {
                    "description": "maximum number of bounty chart snapshots to retain",
                    "type": "integer"
                },
                "break_alliance_duration": {
                    "type": "number"
                },
                "forced_alliances": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "npcs": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                }
                            }
                        },
                        "required": [
                            "npcs"
                        ],
                        "unevaluatedProperties": false
                    }
                },
                "npc_level_minimum_fleet_supply_thresholds": {
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "npc_tags": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "localized_name": {
                                "type": "string"
                            },
                            "name": {
                                "type": "string"
                            }
                        },
                        "required": [
                            "localized_name",
                            "name"
                        ],
                        "unevaluatedProperties": false
                    }
                },
                "reputation_level_texts": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "unevaluatedProperties": false
        },
        "npc_players_with_reputation": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "overwrite_npc_players_with_reputation": {
            "type": "boolean"
        },
        "overwrite_pickable_players": {
            "type": "boolean"
        },
        "pickable_players": {
            "type": "array",
            "items": {
                "type": "string"
            }
        },
        "refund_percentage": {
            "type": "number"
        },
        "research_overflow_tier_nth_root_modifier": {
            "type": "number"
        },
        "version": {
            "type": "integer"
        }
    },
    "required": [
        "auto_upgrade_planet_track_price_threshold_multiplier",
        "colonization_victory_planet_count_percentage",
        "default_corruption_thresholds",
        "default_negative_corruption_buffs",
        "dlc_pickable_players",
        "dominant_culture_influence_points_gained_duration",
        "exotics_refund_percentage",
        "fallback_theme_picker_skybox",
        "fleet_factory_rally_hyperspace_charge_time",
        "fleet_factory_rally_hyperspace_speed",
        "fleet_factory_rally_hyperspace_speed_between_stars",
        "fleet_factory_rally_subspace_speed",
        "marginal_tax_rate_levels",
        "max_fleet_count",
        "max_fleet_supply_scalar",
        "max_research_points_overflow",
        "max_research_rate_scalar",
        "npc_players_with_reputation",
        "pickable_players",
        "refund_percentage",
        "research_overflow_tier_nth_root_modifier"
    ],
    "unevaluatedProperties": false,
    "definitions": {
        "buff_definition_ptr": {
            "type": "string"
        },
        "float_range": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "maxItems": 2
        }
    }
}